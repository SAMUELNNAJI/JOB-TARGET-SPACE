# ─────────────────────────────────────────────────────────────────────────────
# JobSpace — production environment for the VPS.
#
# Copy to the server as /var/www/jobspace/.env, then:
#   chmod 600 /var/www/jobspace/.env && chown jobspace:jobspace /var/www/jobspace/.env
#
# .env is git-ignored. Never commit the real file, and never paste a filled-in
# copy into a chat, an issue, or a commit message.
# ─────────────────────────────────────────────────────────────────────────────

# Required. Generate a fresh one for this server — do NOT reuse the fallback
# that is compiled into settings.py, and do not reuse a Render secret.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Rotating this later signs every user out. It is safe to rotate: sessions and
# CSRF tokens are invalidated, nothing is lost.
SECRET_KEY=PASTE_A_LONG_RANDOM_STRING_HERE

# Keep this False in production. If it were True, Django would serve stack
# traces containing settings — including the secret key — to any visitor.
DEBUG=False

# ── Required: the production database ───────────────────────────────────────
# NOTE: if you are moving an existing production site, point this at the SAME
# PostgreSQL instance the current site uses. Creating a fresh empty database
# here would present a working site with no users and no payment records.
#   postgresql://jobspace:PASSWORD@127.0.0.1:5432/jobspace
DATABASE_URL=postgresql://jobspace:CHANGE_ME@127.0.0.1:5432/jobspace

# ── Required: the domain nginx serves this on ───────────────────────────────
# No scheme, no trailing slash, comma separated. Include www if you serve it.
# Without the real domain here every request is rejected with HTTP 400.
ALLOWED_HOSTS=jobspace.example.com,www.jobspace.example.com

# Required for POST forms once the site is on HTTPS. The origin needs the
# scheme, and no trailing slash: https://jobspace.example.com
# Ignore this while you are still testing over plain HTTP on port 80.
CSRF_TRUSTED_ORIGINS=https://jobspace.example.com,https://www.jobspace.example.com

# ── TLS ─────────────────────────────────────────────────────────────────────
# Leave BOTH of these at 0/False for the first deploy. Turning on
# SECURE_SSL_REDIRECT before the certificate is issued causes a redirect loop,
# and a browser that has cached HSTS cannot be talked out of it for a year.
# Once https://yourdomain loads cleanly, change 0 -> 31536000 and
# False -> True, then `sudo systemctl restart jobspace`.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ── Flutterwave payments ────────────────────────────────────────────────────
# Get these from the Flutterwave dashboard.
#
# IMPORTANT: the webhook at /dashboard/employer/subscription/webhook/ only
# rejects a request when this hash is set — the view's check is
# `if secret_hash and received_hash != secret_hash`. Left empty, ANY caller who
# can reach the URL can POST a fake "charge.completed" body and mark an
# employer's subscription as paid without paying. Set this before going live.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=