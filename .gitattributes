# Normalise line endings on checkout so files edited on Windows and pushed to
# this Linux server do not arrive with CRLF. A CRLF-contaminated .env makes
# python-dotenv fail on the first line, which silently stops DATABASE_URL
# loading and looks like a database or password problem rather than what it is.
* text=auto eol=lf

*.py   text diff=python
*.md   text
*.txt  text
*.sh   text eol=lf
# Preserve execute permission on shell scripts across platforms
deploy/deploy.sh    text eol=lf
deploy/bootstrap.sh text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.service text eol=lf

# Never rewrite these — line endings are part of the file's meaning.
*.png  binary
*.jpg  binary
*.webm binary
*.pdf  binary
